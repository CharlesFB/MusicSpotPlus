<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="LaneItem" style="flex-grow: 1; height: 30px; max-height: 35px; min-height: 30px; flex-direction: row-reverse; justify-content: space-between; width: 100%;">
        <ui:Button text="Remove" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnRemove" style="margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;" />
    </ui:VisualElement>
</ui:UXML>
